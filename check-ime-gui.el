;;; check-ime-gui.el --- Real GUI/module lifecycle -*- lexical-binding: t; -*-
;; Run in a separate GUI Emacs: emacs -Q -l check-ime-gui.el
(require 'cl-lib)
(require 'package)
(defvar neo-ime-candidate-backend)
(defvar neo-ime-input-backend)
(defconst neo-ime-check-root (file-name-directory load-file-name))
(setq native-comp-jit-compilation nil)
(defun neo-ime-gui-check ()
 (let* ((user-emacs-directory (make-temp-file (expand-file-name "var/neo-ime-install-" neo-ime-check-root) t))
       (package-user-dir (expand-file-name "elpa" user-emacs-directory))
       (package-archives nil)
       (package-check-signature nil)
       (frame nil))
  (unwind-protect
      (progn
        (package-initialize)
        (package-install-file (expand-file-name "var/neo-ime-0.2.0.tar" neo-ime-check-root))
        (require 'neo-ime)
        (setq neo-ime-input-backend 'imm32)
        (cl-assert (file-in-directory-p (locate-library "neo-ime") package-user-dir))
        (cl-assert (file-exists-p neo-ime-native-file))
        (setq frame (make-frame '((window-system . w32) (visibility . nil))))
        (select-frame frame)
        (neo-ime-mode 1)
        (cl-assert (featurep 'neo-ime-native))
        (cl-assert (memq (neo-ime-native-status (neo-ime--hwnd frame))
                         '(on off unknown)))
        (cl-assert (eq (neo-ime-native-status 0) 'unknown))
        (cl-assert
         (eq (condition-case err (neo-ime-native-status "invalid")
               (wrong-type-argument (car err)))
             'wrong-type-argument))
        (cl-assert
         (eq (condition-case err (neo-ime-native-snapshot "invalid")
               (wrong-type-argument (car err)))
             'wrong-type-argument))
        (cl-assert (assq frame neo-ime--frames))
        ;; The exclusion rectangle needs room for x+1 and y+height.
        (dolist (coordinates '((2147483647 0 1) (0 2147483647 1)))
          (cl-assert
           (condition-case nil
               (progn (apply #'neo-ime-native-position (neo-ime--hwnd frame) coordinates) nil)
             (error t))))
        (let ((snapshot (neo-ime-native-snapshot (neo-ime--hwnd frame))))
          (cl-assert (equal (aref snapshot 1) ""))
          (cl-assert (not (aref snapshot 4)))
          (cl-assert (null (neo-ime-native-snapshot (neo-ime--hwnd frame) (aref snapshot 0))))
          (neo-ime-native-cancel (neo-ime--hwnd frame))
          (cl-assert (vectorp (neo-ime-native-snapshot (neo-ime--hwnd frame) (aref snapshot 0)))))
        (neo-ime-native-cancel (neo-ime--hwnd frame))
        (neo-ime--poll)
        ;; Synthetic rendering snapshots must not race live native polling.
        (cancel-timer neo-ime--timer)
        (setq neo-ime--timer nil)
        (neo-ime--display (frame-selected-window frame) "亜" 1 [1])
        (redisplay t)
        (neo-ime--show-candidates frame [1 "亜" 1 [1] t ["あ" "亜" "😀"] 1 0 100])
        (cl-assert (frame-live-p neo-ime--candidate-frame))
        (cl-assert (not (assq neo-ime--candidate-frame neo-ime--frames)))
        (cl-assert (frame-parameter neo-ime--candidate-frame 'no-accept-focus))
        (let ((popup neo-ime--candidate-frame))
          (neo-ime--show-candidates frame [2 "亜" 1 [1] t ["あ" "亜" "😀"] 2 0 100])
          (cl-assert (eq popup neo-ime--candidate-frame)))
        (neo-ime--clear)
        (cl-assert (not (frame-visible-p neo-ime--candidate-frame)))
        ;; Optional real Corfu renderer check: add Corfu/compat to load-path
        ;; and set NEO_IME_CHECK_CORFU=1; no mandatory package dependency.
        (when (getenv "NEO_IME_CHECK_CORFU")
          (require 'corfu)
          (make-frame-visible frame)
          (let ((neo-ime-candidate-backend 'corfu))
            (with-current-buffer (window-buffer (frame-selected-window frame))
              (corfu-mode 1)
              (insert "a")
              (completion-in-region (1- (point)) (point) '("abc" "abd"))
              (cl-assert completion-in-region-mode))
            (neo-ime--display (frame-selected-window frame) "亜" 1 [1])
            (cl-assert (not completion-in-region-mode))
            (redisplay t)
            (neo-ime--show-candidates frame [3 "亜" 1 [1] t ["あ" "亜" "😀"] 1 0 100])
            (redisplay t)
            (cl-assert neo-ime--corfu-visible)
            (cl-assert (frame-live-p (symbol-value 'corfu--frame)))
            (cl-assert (frame-visible-p (symbol-value 'corfu--frame)))
            (cl-assert (not (assq (symbol-value 'corfu--frame) neo-ime--frames)))
            (cl-assert (not (frame-visible-p neo-ime--candidate-frame)))
            (with-current-buffer " *corfu*"
              (goto-char (point-min)) (forward-line 1)
              (cl-assert (equal (string-trim
                                 (buffer-substring-no-properties
                                  (line-beginning-position) (line-end-position)))
                                "亜"))
              (let ((face (get-text-property (point) 'face)))
                (cl-assert (or (eq face 'corfu-current)
                               (and (listp face) (memq 'corfu-current face))))))
            (neo-ime--clear)
            (sit-for 0.2)
            (with-current-buffer (window-buffer (frame-selected-window frame))
              (corfu-mode -1))
            (cl-assert (not neo-ime--corfu-visible))
            (cl-assert (not (frame-visible-p (symbol-value 'corfu--frame))))))
        (neo-ime-mode 1)
        (cl-assert (= (length neo-ime--frames)
                      (length (cl-remove-if-not
                               (lambda (f) (and (eq (window-system f) 'w32)
                                                (not (frame-parent f)))) (frame-list)))))
        (neo-ime-mode -1)
        (cl-assert (not neo-ime--frames))
        (cl-assert (not neo-ime--timer))
        (cl-assert (not neo-ime--candidate-frame))
        (cl-assert (not (neo-ime-native-snapshot (neo-ime--hwnd frame))))
        (cl-assert (eq (neo-ime-native-status (neo-ime--hwnd frame)) 'unknown))
        ;; Real frame parameters must remain independent, including detach,
        ;; re-enable, and restoration when no explicit off color is supplied.
        (set-frame-parameter frame 'cursor-color "green")
        (let* ((neo-ime-cursor-color-on "red")
               (neo-ime-cursor-color-off nil)
               (second (make-frame '((window-system . w32) (visibility . nil)
                                     (cursor-color . "blue")))))
          (unwind-protect
              (progn
                (neo-ime-mode 1)
                (neo-ime--update-status frame 'on)
                (neo-ime--update-status second 'off)
                (cl-assert (equal (frame-parameter frame 'cursor-color) "red"))
                (cl-assert (equal (frame-parameter second 'cursor-color) "blue"))
                (cl-assert (eq (neo-ime-status frame) 'on))
                (cl-assert (eq (neo-ime-status second) 'off))
                (neo-ime--update-status second 'on)
                (neo-ime--detach second)
                (cl-assert (equal (frame-parameter second 'cursor-color) "blue"))
                (neo-ime-mode -1)
                (cl-assert (equal (frame-parameter frame 'cursor-color) "green"))
                (cl-assert (eq (neo-ime-status frame) 'unknown))
                (neo-ime-mode 1)
                (neo-ime--update-status frame 'on)
                (neo-ime-mode -1)
                (cl-assert (equal (frame-parameter frame 'cursor-color) "green")))
            (neo-ime-mode -1)
            (delete-frame second t)))
        (neo-ime-mode 1)
        (let ((second (make-frame '((window-system . w32) (visibility . nil)))))
          (cl-assert (assq second neo-ime--frames))
          (delete-frame second t)
          (cl-assert (not (assq second neo-ime--frames))))
        (neo-ime-mode -1)
        (with-temp-file (expand-file-name "var/check-ime-gui.log" neo-ime-check-root)
          (insert (format "NEO_IME_GUI=PASS clean-package-install real-w32-frames enable-disable-reenable status-cursor-restore corfu=%s\n"
                          (if (getenv "NEO_IME_CHECK_CORFU") "tested" "skipped")))))
    (when (fboundp 'neo-ime-mode) (neo-ime-mode -1))
    (when (frame-live-p frame) (delete-frame frame t)))))

(condition-case error-data
    (progn
      (modify-frame-parameters nil '((visibility . nil)))
      (neo-ime-gui-check)
      (kill-emacs 0))
  (error
   (with-temp-file (expand-file-name "var/check-ime-gui.log" neo-ime-check-root)
     (insert (format "NEO_IME_GUI=FAIL %S\n" error-data)))
   (kill-emacs 1)))
