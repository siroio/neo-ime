;;; check-ime-status.el --- IME status and cursor lifecycle -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(add-to-list 'load-path (file-name-directory load-file-name))
(require 'neo-ime)

(ert-deftest neo-ime-status-poll-notifies-only-changes-and-restores-color ()
  (let* ((frame (selected-frame))
         (original (frame-parameter frame 'cursor-color))
         (neo-ime--frames (list (cons frame -1)))
         (neo-ime-cursor-color-on "red")
         (neo-ime-cursor-color-off "blue")
         (status 'on)
         (events nil)
         (neo-ime-status-change-hook
          (list (lambda (changed-frame value)
                  (should (eq changed-frame frame))
                  (should (eq (neo-ime-status frame) value))
                  (push value events)))))
    (cl-letf (((symbol-function 'neo-ime-native-status) (lambda (_) status))
              ((symbol-function 'neo-ime-native-snapshot) (lambda (&rest _) nil))
              ((symbol-function 'neo-ime-native-detach) #'ignore))
      (unwind-protect
          (progn
            (should (eq (neo-ime-status) 'unknown))
            (neo-ime--poll)
            (should (eq (neo-ime-status) 'on))
            (should (equal (frame-parameter frame 'cursor-color) "red"))
            (neo-ime--poll)
            (should (equal events '(on)))
            (setq status 'off)
            (neo-ime--poll)
            (should (eq (neo-ime-status) 'off))
            (should (equal (frame-parameter frame 'cursor-color) "blue"))
            (setq status 'unknown)
            (neo-ime--poll)
            (should (equal (frame-parameter frame 'cursor-color) original))
            (setq status 'on)
            (neo-ime--poll)
            (neo-ime--stop)
            (should (eq (neo-ime-status) 'unknown))
            (should (equal (frame-parameter frame 'cursor-color) original))
            (should (equal events '(unknown on unknown off on))))
        (neo-ime--stop)
        (set-frame-parameter frame 'cursor-color original)))))

(ert-deftest neo-ime-status-without-color-still-notifies ()
  (let* ((frame (selected-frame))
         (original (frame-parameter frame 'cursor-color))
         (neo-ime--frames (list (cons frame -1)))
         (neo-ime-cursor-color-on nil)
         (neo-ime-cursor-color-off nil)
         (events nil)
         (neo-ime-status-change-hook
          (list (lambda (_ value) (push value events)))))
    (cl-letf (((symbol-function 'neo-ime-native-status) (lambda (_) 'on))
              ((symbol-function 'neo-ime-native-snapshot) (lambda (&rest _) nil))
              ((symbol-function 'neo-ime-native-detach) #'ignore))
      (unwind-protect
          (progn
            (neo-ime--poll)
            (should (eq (neo-ime-status) 'on))
            (should (equal events '(on)))
            (should (equal (frame-parameter frame 'cursor-color) original)))
        (neo-ime--stop)))))

(ert-deftest neo-ime-status-color-customization-applies-without-state-change ()
  (let* ((frame (selected-frame))
         (original (frame-parameter frame 'cursor-color))
         (neo-ime--frames (list (cons frame -1)))
         (neo-ime-cursor-color-on "red")
         (neo-ime-status-change-hook nil))
    (cl-letf (((symbol-function 'neo-ime-native-status) (lambda (_) 'on))
              ((symbol-function 'neo-ime-native-snapshot) (lambda (&rest _) nil))
              ((symbol-function 'neo-ime-native-detach) #'ignore))
      (unwind-protect
          (progn
            (neo-ime--poll)
            (setq neo-ime-cursor-color-on "orange")
            (neo-ime--poll)
            (should (equal (frame-parameter frame 'cursor-color) "orange"))
            (setq neo-ime-cursor-color-on nil)
            (neo-ime--poll)
            (should (equal (frame-parameter frame 'cursor-color) original)))
        (neo-ime--stop)
        (set-frame-parameter frame 'cursor-color original)))))

(ert-deftest neo-ime-status-hook-error-does-not-break-cleanup ()
  (let* ((frame (selected-frame))
         (original (frame-parameter frame 'cursor-color))
         (neo-ime--frames (list (cons frame -1)))
         (neo-ime-cursor-color-on "red")
         (neo-ime-status-change-hook (list (lambda (&rest _) (error "Bad hook"))))
         (warnings nil))
    (cl-letf (((symbol-function 'neo-ime-native-status) (lambda (_) 'on))
              ((symbol-function 'neo-ime-native-snapshot) (lambda (&rest _) nil))
              ((symbol-function 'neo-ime-native-detach) #'ignore)
              ((symbol-function 'display-warning)
               (lambda (&rest arguments) (push arguments warnings))))
      (unwind-protect
          (progn
            (neo-ime--poll)
            (should (eq (neo-ime-status) 'on))
            (neo-ime--stop)
            (should (eq (neo-ime-status) 'unknown))
            (should (equal (frame-parameter frame 'cursor-color) original))
            (should warnings))
        (let ((neo-ime-status-change-hook nil)) (neo-ime--stop))
        (set-frame-parameter frame 'cursor-color original)))))

(ert-run-tests-batch-and-exit)
